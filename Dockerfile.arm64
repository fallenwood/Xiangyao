FROM mcr.microsoft.com/azurelinux/core:4-2026111302-distroless-arm64 AS base
WORKDIR /app
EXPOSE 80

FROM mcr.microsoft.com/dotnet/sdk:11.0-azurelinux4.0 AS build
WORKDIR "/src"
COPY . .

FROM mcr.microsoft.com/dotnet/sdk:11.0-azurelinux4.0-arm64v8 AS provider

FROM build AS publish
RUN dotnet publish "src/Xiangyao/Xiangyao.csproj" -f net11.0 -c Release -o /app/publish /p:PublishTrimmed=true -r linux-arm64
RUN rm /app/publish/*.pdb

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .

ENV ASPNETCORE_URLS=http://+:80
ENV ASPNETCORE_ENVIRONMENT=Production
ENV DOTNET_gcServer=1

ENV DOTNET_RuntimeAsync=1

USER root

# Copy ARM64 libstdc++ and its SONAME symlink; the bare base supplies OpenSSL and libgcc.
COPY --from=provider /usr/lib64/libstdc++.so.6* /usr/lib64/

ENTRYPOINT ["./Xiangyao"]
